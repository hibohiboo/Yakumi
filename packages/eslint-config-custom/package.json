{
  "name": "@yakumi/eslint-config-custom",
  "type": "module",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "devDependencies": {
    "@eslint/config-inspector": "^0.6.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-turbo": "^2.3.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-sonarjs": "^3.0.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "scripts": {
    "inspect": "npx @eslint/config-inspector",
    "build": "npx -y @eslint/config-inspector build --base Yakumi/eslint-config-inspector  &&  rm -rf ../../docs/public/eslint-config-inspector && cp -r .eslint-config-inspector ../../docs/public/eslint-config-inspector",
    "ncu": "ncu -u"
  }
}
