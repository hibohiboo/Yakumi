{
  "name": "@yakumi/ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "vite": "vite",
    "build": "tsc && vite build",
    "lint": "eslint",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o ../../docs/public/yakumi-components",
    "clean": "rm -rf .turbo",
    "test": "jest --config ./jest.config.json",
    "ncu": "ncu -u"
  },
  "dependencies": {
    "dompurify": "^3.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.0.10",
    "@storybook/addon-links": "^9.0.10",
    "@storybook/addon-onboarding": "^9.0.10",
    "@storybook/react-vite": "^9.0.10",
    "@storybook/testing-library": "^0.2.2",
    "@types/dompurify": "^3.0.5",
    "@types/sanitize-html": "^2.13.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "@yakumi/tsconfig": "*",
    "eslint-plugin-storybook": "^9.0.10",
    "remark-gfm": "^4.0.1",
    "storybook": "^9.0.10"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "files": [
    "src"
  ],
  "overrides": {
    "storybook": "$storybook"
  }
}
